# Astral (Doois CMS)
ASTRAL_URL=
ASTRAL_PROJECT=
ASTRAL_TOKEN=
ASTRAL_WEBHOOK_SECRET=
ASTRAL_BUILD_WEBHOOK_ID=

# Opcional: host de midia do CMS (o MEDIA_URL dele, como https://cms-media.doois.com.br). Fecha o img-src da Content-Security-Policy nesse host; vazio, o img-src aceita qualquer https:
ASTRAL_MEDIA_URL=

# O site
SITE_URL=

# Opcional: formato das URLs por idioma, se o CMS ainda nao entregar no /schema (prefix, prefix-all, domain, none)
ASTRAL_LOCALE_URLS=
# Opcional: dominios por idioma no formato domain, se o /schema ainda nao entregar (en=https://en.exemplo.com,pt-BR=https://exemplo.com)
ASTRAL_LOCALE_DOMAINS=
# Opcional: so estes idiomas nesta instalacao (formato none: uma instalacao por idioma)
ASTRAL_BUILD_LOCALES=

# Opcional: cache das respostas do CMS em segundos (padrao 60) e por quanto tempo servir a ultima resposta boa se o CMS cair (padrao 604800, 7 dias)
ASTRAL_API_TTL=
ASTRAL_API_STALE=
# Opcional: recriar o cache logo depois de uma limpeza completa pelo webhook (padrao 1)
ASTRAL_WARM_ON_CLEAR=
# Opcional: 0 desliga a compressao gzip feita pelo PHP (quando o servidor ja comprime o HTML)
ASTRAL_GZIP=
# Opcional: Cache-Control das paginas static e revalidate (padrao "public, max-age=0, must-revalidate")
ASTRAL_HTML_CACHE_CONTROL=
# Opcional: pasta de cache fora da raiz publica (padrao var/ ao lado do index.php)
ASTRAL_VAR_DIR=
# Opcional: 1 mostra detalhes de erro na pagina (nunca em producao)
ASTRAL_DEBUG=
